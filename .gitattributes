*.jpeg     binary
*.gif      binary
*.bmp      binary
*.ico      binary
*.tga      binary
*.tiff     binary
*.webp     binary

*.wav      binary
*.mp3      binary
*.ogg      binary
*.flac     binary
*.m4a      binary
*.aiff     binary

*.zip      binary
*.gz       binary
*.tar      binary
*.7z       binary
*.rar      binary
*.xz       binary
*.zst      binary

*.exe      binary
*.dll      binary
*.lib      binary
*.a        binary
*.so       binary
*.dylib    binary
*.o        binary
*.obj      binary
*.pdb      binary
*.ilk      binary
*.idb      binary
*.exp      binary
*.bin      binary

*.pdf      binary
*.doc      binary
*.docx     binary
*.xls      binary
*.xlsx     binary
