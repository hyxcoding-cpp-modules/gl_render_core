*.fbx      binary
*.gltf     binary
*.glb      binary
*.blend    binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.eot      binary

# ------------------------------------------------------------
# 第三方代码：原样保留
#   -text  不做任何换行符转换，保证与上游逐字节一致，
#          同时彻底消除 third_party 下的 CRLF 转换警告；
#   -diff  不参与 diff 显示；
#   linguist-vendored  不计入语言统计。
# 该规则位于 *.bat 等规则之后，因此 third_party 下的文件
# 一律按此处理（例如 vendored 的 windows-presubmit.bat 保持 LF）。
# ------------------------------------------------------------
third_party/**    -text -diff linguist-vendored

# ------------------------------------------------------------
# 构建产物：不 diff、不统计
# ------------------------------------------------------------
build/**          -diff linguist-generated
cmake-build-*/**  -diff linguist-generated

# ------------------------------------------------------------
# 合并策略
# ------------------------------------------------------------
*.lock            merge=ours
package-lock.json merge=ours
