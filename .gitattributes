# ------------------------------------------------------------
# 无扩展名的常见文本文件：LF
# ------------------------------------------------------------
LICENSE       text eol=lf
LICENCE       text eol=lf
COPYING       text eol=lf
NOTICE        text eol=lf
AUTHORS       text eol=lf
CONTRIBUTORS  text eol=lf
README        text eol=lf
CHANGELOG     text eol=lf
VERSION       text eol=lf

# ------------------------------------------------------------
# 编辑器 / Git 配置：LF
# ------------------------------------------------------------
.editorconfig   text eol=lf
.clang-format   text eol=lf
.clang-tidy     text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
.gitmodules     text eol=lf
.gitkeep        text eol=lf

# ------------------------------------------------------------
# Windows 原生脚本：CRLF（唯一的 CRLF 例外）
# 仅作用于本项目自己的脚本；third_party/ 下的同名文件由下方
# 第三方规则接管（见文件末尾，后出现的规则优先级更高）。
# ------------------------------------------------------------
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.psm1     text eol=crlf

