# ============================================================
# .gitignore
# Git 忽略的文件
# ============================================================

# ---------- 构建目录 ----------
build/
build-*/
cmake-build-*/
out/
bin/
lib/
*.dir/

# ---------- CMake ----------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
Makefile
*.cmake.stamp/

# ---------- 编译产物 ----------
*.o
*.obj
*.lo
*.slo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.pdb
*.ilk
*.idb
*.exp
*.map

# ---------- 调试文件 ----------
*.dSYM/
*.su
*.idb
*.pdb
*.gcda
*.gcno
*.gcov

# ---------- 依赖文件 ----------
*.d
*.dep

# ---------- 预编译头 ----------
*.pch
*.gch
*.pch.dep

# ---------- IDE ----------
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- Visual Studio ----------
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# ---------- CLion ----------
.idea/
cmake-build-*/

# ---------- VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json

# ---------- 测试和覆盖率 ----------
Testing/
*.gcda
*.gcno
*.gcov
coverage/
*.profraw
*.profdata

# ---------- 包管理器 ----------
vcpkg_installed/
conan/
conanfile.txt.user
*.conan

# ---------- 依赖目录 ----------
deps/
# third_party/ 下的第三方**源码**（glad / stb）随仓库一起提交，CI 才能拿到；
# 其余依赖统一放在 D:/third_party，由 cmake/ThirdParty.cmake 在配置阶段检查、
# 缺失时下载官方包并解压。本目录不再存放其它第三方内容。
third_party/*
!third_party/README.md
!third_party/glad/
!third_party/stb/

# ---------- 日志和临时文件 ----------
*.log
*.tmp
*.temp
*.cache
*.bak
*.orig
*.rej

# ---------- 运行产物 ----------
*.png.tmp
*.jpg.tmp
output/
results/
screenshots/

# ---------- 敏感信息 ----------
*.key
*.pem
.env
.env.*
secrets/
config.local.*

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- 编辑器临时文件 ----------
*.swp
*.swo
*.swn
*~
*.tmp
*.bak
*.orig
*.rej
.~*

# ---------- 自定义 ----------
# 在这里加项目特有的忽略规则